# Scaleway API Key (READ-ONLY permissions only!)
# SCALEWAY_API_KEY     = SECRET key  -> utilisée comme header X-Auth-Token (obligatoire)
# SCALEWAY_ACCESS_KEY  = ACCESS key  -> identifiant de la clé (informative, pas envoyée par le code)
SCALEWAY_API_KEY=scw_XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
SCALEWAY_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Incident API URL (réseau interne Scaleway - path /core/incidents/)
INCIDENT_API_URL=https://incresponse.incre.prd.fr-par.internal.scaleway.com/core/incidents/

# Console API URL - endpoint resource counts (ConsoleApi.GetFilteredCounters via /dashboard)
CONSOLE_API_URL=https://api.scaleway.com/resource-private/v1alpha1/dashboard

# PostgreSQL Database URL (endpoint privé du RDB sur le PN quand exécuté dans le container)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://root:password@10.11.0.2:5432/rdb
