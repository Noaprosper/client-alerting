# Scaleway API Key (READ-ONLY permissions only!)
# SCALEWAY_API_KEY     = SECRET key  -> utilisée comme header X-Auth-Token
# SCALEWAY_ACCESS_KEY  = ACCESS key  -> identifiant de la clé
SCALEWAY_API_KEY=scw_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SCALEWAY_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Incident API URL
INCIDENT_API_URL=https://incresponse.incre.prd.fr-par.internal.scaleway.com/core/incidents/

# Console API URL - Use /dashboard endpoint for resource counts
CONSOLE_API_URL=https://api.scaleway.com/resource-private/v1alpha1/dashboard

# PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/alert_client